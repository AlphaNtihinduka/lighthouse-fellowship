# Copy to .env next to docker-compose.yml and fill in real values.
# .env is never committed. Keep an encrypted copy of the VPS .env in a password manager.

# --- Database
POSTGRES_DB=lighthouse
POSTGRES_USER=lighthouse
POSTGRES_PASSWORD=replace_with_secure_db_password

# --- Admin JWT. Generate with: openssl rand -base64 48
# Rotating it signs every admin out of the dashboard.
JWT_ADMIN_SECRET=replace_with_secure_admin_jwt_secret
# 8 hours
JWT_ADMIN_EXPIRATION_MS=28800000

# --- First admin, created on startup only if that email has no account yet.
# An existing account's password is never overwritten. Change the password after the
# first login (dashboard Account page or PATCH /api/admin/account/password).
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_a_long_seed_password
ADMIN_SEED_DISPLAY_NAME=Pastor Joe Benecasa

# --- Cloudinary (cover images). From the Cloudinary console: cloudinary://<key>:<secret>@<cloud>
CLOUDINARY_URL=cloudinary://replace_key:replace_secret@replace_cloud_name

# --- Dashboard origins allowed by CORS, comma separated.
# VPS testing: http://<VPS_IP>:8100
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only set to true once the host Nginx proxies the API (phase 6).
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false

# Backend image. The deploy workflow pins this to the commit SHA on each deploy;
# set it to an older SHA to roll back.
BACKEND_IMAGE=alphadevug/lighthouse-fellowship-backend:latest
